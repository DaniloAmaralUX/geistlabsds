{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "profile-page",
  "title": "Perfil",
  "description": "Cabeçalho de perfil com avatar e abas de dados pessoais, conta, segurança e notificações.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "avatar",
    "https://geistlabsds.vercel.app/r/badge.json",
    "https://geistlabsds.vercel.app/r/button.json",
    "card",
    "https://geistlabsds.vercel.app/r/input.json",
    "label",
    "separator",
    "switch",
    "tabs",
    "textarea"
  ],
  "files": [
    {
      "path": "registry/new-york/blocks/profile-page/page.tsx",
      "content": "import ProfileContent from \"./components/profile-content\";\nimport ProfileHeader from \"./components/profile-header\";\n\n/**\n * Perfil — Supernova.\n *\n * Cabeçalho com avatar e abas de dados pessoais, conta, segurança e\n * notificações. Base: `shadcn-examples` (shadcn/ui, MIT), adaptado.\n */\nexport default function Page() {\n  return (\n    <div className=\"container mx-auto space-y-6 px-4 py-10\">\n      <ProfileHeader />\n      <ProfileContent />\n    </div>\n  );\n}\n",
      "type": "registry:page",
      "target": "components/blocos/profile-page/page.tsx"
    },
    {
      "path": "registry/new-york/blocks/profile-page/components/profile-header.tsx",
      "content": "import { CalendarIcon, CameraIcon, MailIcon, MapPinIcon } from \"lucide-react\";\n\nimport { Avatar, AvatarFallback } from \"@/components/ui/avatar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\n\nexport default function ProfileHeader() {\n  return (\n    <Card>\n      <CardContent className=\"p-6\">\n        <div className=\"flex flex-col items-start gap-6 md:flex-row md:items-center\">\n          <div className=\"relative\">\n            <Avatar className=\"size-24\">\n              <AvatarFallback className=\"text-2xl\">JD</AvatarFallback>\n            </Avatar>\n            <Button\n              aria-label=\"Alterar foto do perfil\"\n              className=\"absolute -right-2 -bottom-2\"\n              shape=\"circle\"\n              size=\"sm\"\n              variant=\"secondary\"\n            >\n              <CameraIcon />\n            </Button>\n          </div>\n          <div className=\"flex-1 space-y-2\">\n            <div className=\"flex flex-col gap-2 md:flex-row md:items-center\">\n              <h1 className=\"font-bold text-2xl\">John Doe</h1>\n              <Badge appearance=\"subtle\" color=\"gray\">\n                Membro Pro\n              </Badge>\n            </div>\n            <p className=\"text-muted-foreground\">Designer de produto sênior</p>\n            <div className=\"flex flex-wrap gap-4 text-muted-foreground text-sm\">\n              <div className=\"flex items-center gap-1\">\n                <MailIcon aria-hidden=\"true\" className=\"size-4\" />\n                john.doe@example.com\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <MapPinIcon aria-hidden=\"true\" className=\"size-4\" />\n                São Paulo, SP\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <CalendarIcon aria-hidden=\"true\" className=\"size-4\" />\n                Entrou em março de 2023\n              </div>\n            </div>\n          </div>\n          <Button variant=\"primary\">Editar perfil</Button>\n        </div>\n      </CardContent>\n    </Card>\n  );\n}\n",
      "type": "registry:component",
      "target": "components/blocos/profile-page/components/profile-header.tsx"
    },
    {
      "path": "registry/new-york/blocks/profile-page/components/profile-content.tsx",
      "content": "import { KeyIcon, ShieldIcon, Trash2Icon } from \"lucide-react\";\n\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Separator } from \"@/components/ui/separator\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Textarea } from \"@/components/ui/textarea\";\n\nexport default function ProfileContent() {\n  return (\n    <Tabs className=\"space-y-6\" defaultValue=\"personal\">\n      <TabsList className=\"grid w-full grid-cols-4\">\n        <TabsTrigger value=\"personal\">Pessoal</TabsTrigger>\n        <TabsTrigger value=\"account\">Conta</TabsTrigger>\n        <TabsTrigger value=\"security\">Segurança</TabsTrigger>\n        <TabsTrigger value=\"notifications\">Notificações</TabsTrigger>\n      </TabsList>\n\n      {/* Informações pessoais */}\n      <TabsContent className=\"space-y-6\" value=\"personal\">\n        <Card>\n          <CardHeader>\n            <CardTitle>Informações pessoais</CardTitle>\n            <CardDescription>\n              Atualize seus dados pessoais e as informações do perfil.\n            </CardDescription>\n          </CardHeader>\n          <CardContent className=\"space-y-6\">\n            <div className=\"grid grid-cols-1 gap-6 md:grid-cols-2\">\n              <Input defaultValue=\"John\" id=\"firstName\" label=\"Nome\" />\n              <Input defaultValue=\"Doe\" id=\"lastName\" label=\"Sobrenome\" />\n              <Input\n                defaultValue=\"john.doe@example.com\"\n                id=\"email\"\n                label=\"E-mail\"\n                type=\"email\"\n              />\n              <Input\n                defaultValue=\"+55 (11) 91234-5678\"\n                id=\"phone\"\n                label=\"Telefone\"\n                type=\"tel\"\n              />\n              <Input\n                defaultValue=\"Designer de produto sênior\"\n                id=\"jobTitle\"\n                label=\"Cargo\"\n              />\n              <Input defaultValue=\"Acme Ltda.\" id=\"company\" label=\"Empresa\" />\n            </div>\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"bio\">Biografia</Label>\n              <Textarea\n                defaultValue=\"Designer de produto com mais de 8 anos de experiência criando experiências digitais centradas nas pessoas. Gosto de resolver problemas complexos e transformar ideias em produtos bonitos e funcionais.\"\n                id=\"bio\"\n                placeholder=\"Conte um pouco sobre você...\"\n                rows={4}\n              />\n            </div>\n            <Input\n              defaultValue=\"São Paulo, SP\"\n              id=\"location\"\n              label=\"Localização\"\n            />\n          </CardContent>\n        </Card>\n      </TabsContent>\n\n      {/* Configurações da conta */}\n      <TabsContent className=\"space-y-6\" value=\"account\">\n        <Card>\n          <CardHeader>\n            <CardTitle>Configurações da conta</CardTitle>\n            <CardDescription>\n              Gerencie as preferências da conta e a assinatura.\n            </CardDescription>\n          </CardHeader>\n          <CardContent className=\"space-y-6\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"space-y-1\">\n                <Label className=\"text-base\">Status da conta</Label>\n                <p className=\"text-muted-foreground text-sm\">\n                  Sua conta está ativa no momento\n                </p>\n              </div>\n              <Badge appearance=\"subtle\" color=\"green\">\n                Ativa\n              </Badge>\n            </div>\n            <Separator />\n            <div className=\"flex items-center justify-between\">\n              <div className=\"space-y-1\">\n                <Label className=\"text-base\">Plano de assinatura</Label>\n                <p className=\"text-muted-foreground text-sm\">\n                  Plano Pro — R$ 149/mês\n                </p>\n              </div>\n              <Button variant=\"secondary\">Gerenciar assinatura</Button>\n            </div>\n            <Separator />\n            <div className=\"flex items-center justify-between\">\n              <div className=\"space-y-1\">\n                <Label className=\"text-base\" htmlFor=\"account-visibility\">\n                  Visibilidade da conta\n                </Label>\n                <p className=\"text-muted-foreground text-sm\">\n                  Torne seu perfil visível para outros usuários\n                </p>\n              </div>\n              <Switch defaultChecked id=\"account-visibility\" />\n            </div>\n            <Separator />\n            <div className=\"flex items-center justify-between\">\n              <div className=\"space-y-1\">\n                <Label className=\"text-base\">Exportação de dados</Label>\n                <p className=\"text-muted-foreground text-sm\">\n                  Baixe uma cópia dos seus dados\n                </p>\n              </div>\n              <Button variant=\"secondary\">Exportar dados</Button>\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card className=\"border-destructive/50\">\n          <CardHeader>\n            <CardTitle className=\"text-destructive\">Zona de perigo</CardTitle>\n            <CardDescription>Ações irreversíveis e destrutivas</CardDescription>\n          </CardHeader>\n          <CardContent>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"space-y-1\">\n                <Label className=\"text-base\">Excluir conta</Label>\n                <p className=\"text-muted-foreground text-sm\">\n                  Exclui permanentemente sua conta e todos os dados\n                </p>\n              </div>\n              <Button\n                prefix={<Trash2Icon aria-hidden=\"true\" />}\n                variant=\"error\"\n              >\n                Excluir conta\n              </Button>\n            </div>\n          </CardContent>\n        </Card>\n      </TabsContent>\n\n      {/* Configurações de segurança */}\n      <TabsContent className=\"space-y-6\" value=\"security\">\n        <Card>\n          <CardHeader>\n            <CardTitle>Configurações de segurança</CardTitle>\n            <CardDescription>\n              Gerencie a segurança e a autenticação da conta.\n            </CardDescription>\n          </CardHeader>\n          <CardContent className=\"space-y-6\">\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"space-y-1\">\n                  <Label className=\"text-base\">Senha</Label>\n                  <p className=\"text-muted-foreground text-sm\">\n                    Alterada há 3 meses\n                  </p>\n                </div>\n                <Button\n                  prefix={<KeyIcon aria-hidden=\"true\" />}\n                  variant=\"secondary\"\n                >\n                  Alterar senha\n                </Button>\n              </div>\n              <Separator />\n              <div className=\"flex items-center justify-between\">\n                <div className=\"space-y-1\">\n                  <Label className=\"text-base\">\n                    Autenticação em duas etapas\n                  </Label>\n                  <p className=\"text-muted-foreground text-sm\">\n                    Adicione uma camada extra de segurança à conta\n                  </p>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <Badge appearance=\"subtle\" color=\"green\">\n                    Ativada\n                  </Badge>\n                  <Button size=\"sm\" variant=\"secondary\">\n                    Configurar\n                  </Button>\n                </div>\n              </div>\n              <Separator />\n              <div className=\"flex items-center justify-between\">\n                <div className=\"space-y-1\">\n                  <Label className=\"text-base\" htmlFor=\"login-notifications\">\n                    Notificações de acesso\n                  </Label>\n                  <p className=\"text-muted-foreground text-sm\">\n                    Receba um aviso quando alguém entrar na sua conta\n                  </p>\n                </div>\n                <Switch defaultChecked id=\"login-notifications\" />\n              </div>\n              <Separator />\n              <div className=\"flex items-center justify-between\">\n                <div className=\"space-y-1\">\n                  <Label className=\"text-base\">Sessões ativas</Label>\n                  <p className=\"text-muted-foreground text-sm\">\n                    Gerencie os dispositivos conectados à sua conta\n                  </p>\n                </div>\n                <Button\n                  prefix={<ShieldIcon aria-hidden=\"true\" />}\n                  variant=\"secondary\"\n                >\n                  Ver sessões\n                </Button>\n              </div>\n            </div>\n          </CardContent>\n        </Card>\n      </TabsContent>\n\n      {/* Preferências de notificação */}\n      <TabsContent className=\"space-y-6\" value=\"notifications\">\n        <Card>\n          <CardHeader>\n            <CardTitle>Preferências de notificação</CardTitle>\n            <CardDescription>\n              Escolha quais notificações deseja receber.\n            </CardDescription>\n          </CardHeader>\n          <CardContent className=\"space-y-6\">\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"space-y-1\">\n                  <Label className=\"text-base\" htmlFor=\"email-notifications\">\n                    Notificações por e-mail\n                  </Label>\n                  <p className=\"text-muted-foreground text-sm\">\n                    Receba notificações por e-mail\n                  </p>\n                </div>\n                <Switch defaultChecked id=\"email-notifications\" />\n              </div>\n              <Separator />\n              <div className=\"flex items-center justify-between\">\n                <div className=\"space-y-1\">\n                  <Label className=\"text-base\" htmlFor=\"push-notifications\">\n                    Notificações push\n                  </Label>\n                  <p className=\"text-muted-foreground text-sm\">\n                    Receba notificações push no navegador\n                  </p>\n                </div>\n                <Switch id=\"push-notifications\" />\n              </div>\n              <Separator />\n              <div className=\"flex items-center justify-between\">\n                <div className=\"space-y-1\">\n                  <Label className=\"text-base\" htmlFor=\"marketing-emails\">\n                    E-mails de marketing\n                  </Label>\n                  <p className=\"text-muted-foreground text-sm\">\n                    Receba e-mails sobre novidades e atualizações\n                  </p>\n                </div>\n                <Switch defaultChecked id=\"marketing-emails\" />\n              </div>\n              <Separator />\n              <div className=\"flex items-center justify-between\">\n                <div className=\"space-y-1\">\n                  <Label className=\"text-base\" htmlFor=\"weekly-summary\">\n                    Resumo semanal\n                  </Label>\n                  <p className=\"text-muted-foreground text-sm\">\n                    Receba um resumo semanal da sua atividade\n                  </p>\n                </div>\n                <Switch defaultChecked id=\"weekly-summary\" />\n              </div>\n              <Separator />\n              <div className=\"flex items-center justify-between\">\n                <div className=\"space-y-1\">\n                  <Label className=\"text-base\" htmlFor=\"security-alerts\">\n                    Alertas de segurança\n                  </Label>\n                  <p className=\"text-muted-foreground text-sm\">\n                    Notificações de segurança importantes (sempre ativas)\n                  </p>\n                </div>\n                <Switch checked disabled id=\"security-alerts\" />\n              </div>\n            </div>\n          </CardContent>\n        </Card>\n      </TabsContent>\n    </Tabs>\n  );\n}\n",
      "type": "registry:component",
      "target": "components/blocos/profile-page/components/profile-content.tsx"
    }
  ],
  "categories": [
    "blocos"
  ],
  "type": "registry:block"
}