{
  "name": "supernova-ds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm tokens:build && pnpm themes:build && pnpm registry:build && next build",
    "check": "ultracite check",
    "dev": "pnpm tokens:build && pnpm themes:build && next dev",
    "fix": "ultracite fix",
    "postinstall": "fumadocs-mdx",
    "prepare": "lefthook install",
    "registry:build": "shadcn build registry.json --output ./public/r",
    "start": "next start",
    "themes:build": "node --experimental-strip-types --no-warnings scripts/build-themes.ts && oxfmt styles/palettes.css public/themes",
    "tokens:build": "node --experimental-strip-types --no-warnings scripts/build-tokens.ts && oxfmt registry.json",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-table": "^9.2.4",
    "@vercel/analytics": "^2.0.1",
    "@web-kits/audio": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.8.4",
    "fumadocs-mdx": "^14.3.1",
    "jiti": "^2.6.1",
    "jotai": "^2.19.1",
    "lru-cache": "^11.3.5",
    "lucide-react": "1.11.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "0.4.6",
    "postcss": "^8.5.10",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hotkeys-hook": "^5.2.4",
    "recharts": "^3.10.1",
    "rehype-pretty-code": "^0.14.3",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ts-morph": "^26.0.0",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "shadcn": "4.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "7.6.1"
  }
}
