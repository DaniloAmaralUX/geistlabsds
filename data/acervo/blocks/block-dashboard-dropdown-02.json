{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "block-dashboard-dropdown-02",
  "type": "registry:block",
  "title": "Dashboard Dropdown 02",
  "description": "Bloco para produto, adaptado de shadcn/studio e pronto para o seu produto.",
  "author": "Supernova Shadcn (adaptado de shadcn/studio)",
  "categories": ["produto", "bloco"],
  "docs": "Arquivos em components/supernova/dashboard-dropdown-02/. Comece pelo example.tsx (composição de referência) e troque os dados de demonstração. Prévia e código: https://supernovacn.vercel.app/docs/app-ui/produto/dashboard-dropdown-02. Créditos e licenças: https://supernovacn.vercel.app/docs/credits",
  "dependencies": [],
  "registryDependencies": ["avatar", "dropdown-menu"],
  "files": [
    {
      "path": "components/supernova/dashboard-dropdown-02/example.tsx",
      "type": "registry:component",
      "target": "components/supernova/dashboard-dropdown-02/example.tsx",
      "content": "import { Avatar, AvatarImage, AvatarFallback } from '@/components/ui/avatar'\n\nimport ProfileDropdown from '@/components/supernova/dashboard-dropdown-02/blocks/dropdown-profile'\n\nconst DropdownPage = () => {\n  return (\n    <div className='flex h-132 items-start justify-center p-8'>\n      <ProfileDropdown\n        defaultOpen\n        align='center'\n        trigger={\n          <button className='rounded-full'>\n            <Avatar size='lg' className='cursor-pointer'>\n              <AvatarImage src='https://cdn.shadcnstudio.com/ss-assets/avatar/avatar-1.png' alt='John Doe' />\n              <AvatarFallback>JD</AvatarFallback>\n            </Avatar>\n          </button>\n        }\n      />\n    </div>\n  )\n}\n\nexport default DropdownPage\n"
    },
    {
      "path": "components/supernova/dashboard-dropdown-02/blocks/dropdown-profile.tsx",
      "type": "registry:component",
      "target": "components/supernova/dashboard-dropdown-02/blocks/dropdown-profile.tsx",
      "content": "import type { ReactElement } from 'react'\nimport { Avatar, AvatarImage, AvatarFallback } from '@/components/ui/avatar'\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger\n} from '@/components/ui/dropdown-menu'\nimport { UserIcon, SettingsIcon, CreditCardIcon, UsersIcon, SquarePenIcon, CirclePlusIcon, LogOutIcon } from 'lucide-react'\n\ntype Props = {\n  trigger: ReactElement\n  defaultOpen?: boolean\n  align?: 'start' | 'center' | 'end'\n}\n\nconst ProfileDropdown = ({ trigger, defaultOpen, align = 'end' }: Props) => {\n  return (\n    <DropdownMenu defaultOpen={defaultOpen}>\n      <DropdownMenuTrigger render={trigger} />\n      <DropdownMenuContent className='w-80' align={align || 'end'}>\n        <DropdownMenuGroup>\n          <DropdownMenuLabel className='flex items-center gap-4 px-4 py-2.5 font-normal'>\n            <div className='relative'>\n              <Avatar size='lg'>\n                <AvatarImage src='https://cdn.shadcnstudio.com/ss-assets/avatar/avatar-1.png' alt='John Doe' />\n                <AvatarFallback>JD</AvatarFallback>\n              </Avatar>\n              <span className='ring-card absolute right-0 bottom-0 block size-2 rounded-full bg-green-600 ring-2' />\n            </div>\n            <div className='flex flex-1 flex-col items-start'>\n              <span className='text-foreground text-lg font-semibold'>John Doe</span>\n              <span className='text-muted-foreground text-base'>john.doe@example.com</span>\n            </div>\n          </DropdownMenuLabel>\n        </DropdownMenuGroup>\n\n        <DropdownMenuSeparator />\n\n        <DropdownMenuGroup>\n          <DropdownMenuItem className='gap-2 px-4 py-2.5 text-base'>\n            <UserIcon className='text-foreground size-5' />\n            <span>My account</span>\n          </DropdownMenuItem>\n          <DropdownMenuItem className='gap-2 px-4 py-2.5 text-base'>\n            <SettingsIcon className='text-foreground size-5' />\n            <span>Settings</span>\n          </DropdownMenuItem>\n          <DropdownMenuItem className='gap-2 px-4 py-2.5 text-base'>\n            <CreditCardIcon className='text-foreground size-5' />\n            <span>Billing</span>\n          </DropdownMenuItem>\n        </DropdownMenuGroup>\n\n        <DropdownMenuSeparator />\n\n        <DropdownMenuGroup>\n          <DropdownMenuItem className='gap-2 px-4 py-2.5 text-base'>\n            <UsersIcon className='text-foreground size-5' />\n            <span>Manage team</span>\n          </DropdownMenuItem>\n          <DropdownMenuItem className='gap-2 px-4 py-2.5 text-base'>\n            <SquarePenIcon className='text-foreground size-5' />\n            <span>Customization</span>\n          </DropdownMenuItem>\n          <DropdownMenuItem className='gap-2 px-4 py-2.5 text-base'>\n            <CirclePlusIcon className='text-foreground size-5' />\n            <span>Add team account</span>\n          </DropdownMenuItem>\n        </DropdownMenuGroup>\n\n        <DropdownMenuSeparator />\n\n        <DropdownMenuGroup>\n          <DropdownMenuItem variant='destructive' className='gap-2 px-4 py-2.5 text-base'>\n            <LogOutIcon className='size-5' />\n            <span>Logout</span>\n          </DropdownMenuItem>\n        </DropdownMenuGroup>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  )\n}\n\nexport default ProfileDropdown\n"
    }
  ],
